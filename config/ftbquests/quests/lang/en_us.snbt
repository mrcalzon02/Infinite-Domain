	quest.5D00000000000019.title: "Southern Survey: Sulfuric Valley"
	quest.5E00000000000001.quest_desc: [
		"Create trains extend the mod's local kinetic factories into scheduled regional freight."
		"Build a freight route between distinct production sites; local belts remain factory infrastructure."
		"Objective: obtain 2 × Train Station. The terminal detects these items without consuming them."
	]
	quest.5E00000000000001.title: "Regional Freight"
	quest.5E00000000000002.quest_desc: [
		"Use stock links and schedules to make demand visible instead of relying on memory."
		"Objective: obtain 2 × Stock Link. The terminal detects these items without consuming them."
	]
	quest.5E00000000000002.title: "Scheduled Delivery"
	quest.5E00000000000003.quest_desc: [
		"Enter deep ocean and survey a route wide enough for large vessels."
		"Objective: visit Deep Ocean. The terminal detects the biome at your position automatically."
	]
	quest.5E00000000000003.title: "Reach Open Water"
	quest.5E00000000000004.quest_desc: [
		"Enter any registered Seven Seas ship structure. The task uses a structure tag so compatible ships count."
		"Objective: enter #Ships. The terminal verifies the generated structure while you stand inside it."
	]
	quest.5E00000000000004.title: "A Ship Worth Charting"
	quest.5E00000000000005.quest_desc: [
		"Build pressurization before treating the ocean floor as ordinary terrain."
		"Objective: obtain 1 × Iron Pressurizer. The terminal detects these items without consuming them."
	]
	quest.5E00000000000005.title: "Pressure Hull Systems"
	quest.5E00000000000006.quest_desc: [
		"Commission controlled buoyancy and a submarine propeller as one tested system."
		"Objective: obtain 4 × Ballast Tank. The terminal detects these items without consuming them."
	]
	quest.5E00000000000006.title: "Ballast and Propulsion"
	quest.5E00000000000007.quest_desc: [
		"Turn a designed structure into a vehicle only after mass, controls, and recovery procedures are understood."
		"Objective: obtain 1 × Physics Assembler. The terminal detects these items without consuming them."
	]
	quest.5E00000000000007.title: "Physics Assembly"
	quest.5E00000000000008.quest_desc: [
		"Construct meaningful lift volume and leave safety margin for cargo."
		"Objective: obtain 32 × White Envelope. The terminal detects these items without consuming them."
	]
	quest.5E00000000000008.title: "Lift Envelope"
	quest.5E00000000000009.quest_desc: [
		"Install controllable propulsion with protected moving parts."
		"Objective: obtain 4 × Propeller Bearing. The terminal detects these items without consuming them."
	]
	quest.5E00000000000009.title: "Controlled Propulsion"
	quest.5E0000000000000A.quest_desc: [
		"Build origin and destination stations rather than an impressive vehicle with nowhere to operate."
		"Objective: obtain 2 × Airship Station. The terminal detects these items without consuming them."
	]
	quest.5E0000000000000A.title: "Named Airship Station"
	quest.5E0000000000000B.quest_desc: [
		"Identify vehicles and connect them to a logistics terminal."
		"Objective: obtain 2 × Ship Transponder. The terminal detects these items without consuming them."
	]
	quest.5E0000000000000B.title: "Transponder and Terminal"
	quest.5E0000000000000C.quest_desc: [
		"Commission radar, identification, and a safe-zone policy before automated traffic scales."
		"Objective: obtain 1 × Radar Dish Block. The terminal detects these items without consuming them."
	]
	quest.5E0000000000000C.title: "Radar Discipline"
	quest.5E0000000000000D.quest_desc: [
		"Stellaris supplies the rockets, life support, destinations, and off-world resources for orbital progression."
		"Reach the Moon with cargo capacity and a documented return plan."
		"Objective: visit Moon."
	]
	quest.5E0000000000000D.title: "Interplanetary Freight"
	quest.5E0000000000000E.quest_desc: [
		"Enter a Moon space base and establish it as a surveyed logistics destination."
		"Objective: enter Moon Space Base. The terminal verifies the generated structure while you stand inside it."
	]
	quest.5E0000000000000E.title: "A Destination Beyond Earth"
	quest.5E0000000000000F.quest_desc: [
		"Enter the alternate Wasteland dimension as a late-era expedition. Establish a protected arrival point, record the return method, and compare its resources and hazards with the primary world."
		"Objective: visit The Wasteland."
	]
	quest.5E0000000000000F.title: "Through the Other Wasteland"
	quest.5E00000000000010.quest_desc: [
		"Ignite the reinforced-deepslate portal in the Ancient City with the Echo Stone and enter the Nether. Ordinary obsidian portals cannot be activated in this pack."
		"The Nether is a high lava-ocean world. The completed submarine and airship programs are operational prerequisites: travel below the lava or above it instead of relying on continuous land."
		"Objective: visit The Nether."
	]
	quest.5E00000000000010.title: "Through the Only Door Below"
	quest.5E00000000000011.quest_desc: [
		"The End route opens only after the Nether expedition enters the relocated stronghold. Secure the arrival platform, prove the return route, and prepare later transport infrastructure without treating arrival alone as mastery."
		"Objective: visit The End."
	]
	quest.5E00000000000011.title: "The End of the Route"
	quest.5E00000000000012.quest_desc: [
		"Survey the alternate Wasteland polluted ocean and mark a landing site that keeps contaminated water outside the expedition supply chain."
		"Objective: visit Polluted Ocean. The terminal detects the biome at your position automatically."
	]
	quest.5E00000000000012.title: "Poisoned Coastline"
	quest.5E00000000000013.quest_desc: [
		"Enter the radioactive interior with active monitoring and record safe exposure limits, shelter intervals, and an evacuation bearing."
		"Objective: visit Radioactive Wasteland. The terminal detects the biome at your position automatically."
	]
	quest.5E00000000000013.title: "The Irradiated Interior"
	quest.5E00000000000014.quest_desc: [
		"Survey the dimension's decayed forest for renewable biological material without confusing unfamiliar growth with safe growth."
		"Objective: visit Decayed Forest. The terminal detects the biome at your position automatically."
	]
	quest.5E00000000000014.title: "The Decayed Forest"
	quest.5E00000000000015.quest_desc: [
		"Reach a sulfuric valley and complete the four-biome alternate-Wasteland survey with a documented return route."
		"Objective: visit Sulfuric Valley. The terminal detects the biome at your position automatically."
	]
	quest.5E00000000000015.title: "Sulfuric Boundary Survey"
	quest.5E00000000000016.quest_desc: [
		"Survey a Basalt Delta for ash, broken sightlines, magma hazards, and the foundations required for a protected freight route."
		"Objective: visit Basalt Deltas. The terminal detects the biome at your position automatically."
	]
	quest.5E00000000000016.title: "Basalt Shipping Hazards"
	quest.5E00000000000017.quest_desc: [
		"Enter a Nether Fortress and mark a repeatable protected route from the portal before treating blaze products as ordinary freight."
		"Objective: enter Fortress. The terminal verifies the generated structure while you stand inside it."
	]
	quest.5E00000000000017.title: "Secure a Fortress Route"
	quest.5E00000000000018.quest_desc: [
		"Cross a Soul Sand Valley and establish navigation markers that remain visible through fog and hostile fire."
		"Objective: visit Soul Sand Valley. The terminal detects the biome at your position automatically."
	]
	quest.5E00000000000018.title: "Cross the Soul-Sand Expanse"
	quest.5E00000000000019.quest_desc: [
		"Enter a Bastion Remnant as the final Nether logistics survey; document access, defenses, salvage rules, and a route that does not depend on improvised escape."
		"Objective: enter Bastion Remnant. The terminal verifies the generated structure while you stand inside it."
	]
	quest.5E00000000000019.title: "Bastion Cargo Survey"
	quest.5E0000000000001E.quest_desc: [
		"Find a stronghold embedded in the Nether. Infinite Domain relocates the stronghold ring here, making lava-ocean navigation part of required End progression."
		"Objective: enter Stronghold. The terminal verifies the generated structure while you stand inside it."
	]
	quest.5E0000000000001E.title: "Stronghold Beneath the Lava Sky"
	quest.5E00000000000020.quest_desc: [
		"Build an Ancient Compass before committing an expedition south. Its recipe is deliberately pre-Nether: diamond blocks replace the mod's normally circular Netherite Scrap requirement."
		"Objective: obtain 1 × Ancient Compass. The terminal detects this item without consuming it."
	]
	quest.5E00000000000020.title: "A Needle for the Buried City"
	quest.5E00000000000021.quest_desc: [
		"Follow the compass into the southern sulfuric territory and physically enter an Ancient City. Its reinforced-deepslate frame is the only legitimate Nether doorway."
		"Objective: enter Ancient City. The terminal verifies the generated structure while you stand inside it."
	]
	quest.5E00000000000021.title: "The Buried Gate"
	quest.5E00000000000022.quest_desc: [
		"Recover four Echo Shards from the city and combine them with an Amethyst Shard to craft the Echo Stone. This is the Ancient City portal's dedicated igniter."
		"Objective: obtain 1 × Echo Stone. The terminal detects this item without consuming it."
	]
	quest.5E00000000000022.title: "Echo-Key Authorization"
	quest.5E0000000000001A.quest_desc: [
		"Collect dragon breath under controlled conditions and return it through the secured End gateway as proof that the central-island expedition is supportable."
		"Objective: obtain 4 × Dragon Breath. The terminal detects these items without consuming them."
	]
	quest.5E0000000000001A.title: "Dragonflight Sampling"
	quest.5E0000000000001B.quest_desc: [
		"Reach the End Highlands and establish a marked outer-island landing point beyond the central dragon arena."
		"Objective: visit End Highlands. The terminal detects the biome at your position automatically."
	]
	quest.5E0000000000001B.title: "Beyond the Central Void"
	quest.5E0000000000001C.quest_desc: [
		"Enter an End City and survey vertical access, hostile positions, cargo extraction, and the return bearing to the gateway network."
		"Objective: enter End City. The terminal verifies the generated structure while you stand inside it."
	]
	quest.5E0000000000001C.title: "Locate an End City"
	quest.5E0000000000001D.quest_desc: [
		"Return enough shulker shells to establish reproducible dimensional freight containers rather than treating one lucky city as a complete logistics system."
		"Objective: obtain 8 × Shulker Shell. The terminal detects these items without consuming them."
	]
	quest.5E0000000000001D.title: "Shulker Freight Standard"
	quest.6101000000000001.quest_desc: [
		"Begin with Shafts, Cogwheels, and Large Cogwheels. Shafts carry rotation in a straight line. Cogwheels transfer it sideways when their teeth actually touch—a demanding requirement, I know."
		"Place equal-sized cogs beside one another to preserve speed and reverse direction. Mesh a Large Cogwheel with a Cogwheel to double or halve speed depending on which one drives the pair. Create highlights valid connections, so do try to notice when the machine is helping you."
		"Obtain 8 Shafts, 4 Cogwheels, and 2 Large Cogwheels. The task detects them without consuming them."
	]
	quest.6101000000000001.title: "Teeth, Shafts, and the Apparently Mysterious Wheel"
	quest.6101000000000002.quest_desc: [
		"Attach a Hand Crank directly to a shaft or machine input and hold use to provide temporary rotation. It is weak and it occupies one of your hands, much like several early engineering decisions."
		"Use it to verify direction and placement before committing a permanent power source. If nothing moves, inspect the highlighted connection rather than cranking with greater moral conviction."
		"Obtain a Hand Crank. The task detects it without consuming it."
	]
	quest.6101000000000002.title: "Rotation, Supplied by Hand"
	quest.6101000000000003.quest_desc: [
		"A Gearbox redirects rotation between perpendicular faces. Connect the incoming shaft to one face and take output from another; the visible shaft openings are not decorative suggestions."
		"Adjacent outputs may reverse relative direction. Test the gearbox with your Hand Crank before routing it through machinery that objects to surprises."
		"Obtain a Gearbox. The task detects it without consuming it."
	]
	quest.6101000000000003.title: "Turning a Corner Without Negotiation"
	quest.6101000000000004.quest_desc: [
		"Place a Speedometer against a rotating shaft. Its dial and tooltip report RPM, allowing us to distinguish ‘slow’ from the more technically useful ‘exactly how slow.’"
		"Use cog ratios to change the reading: drive a small Cogwheel from a Large Cogwheel to increase speed, or reverse the arrangement to reduce it. Observe the result instead of trusting intuition; intuition has no calibrated scale."
		"Obtain a Speedometer. The task detects it without consuming it."
	]
	quest.6101000000000004.title: "Measure Speed Before Complaining About It"
	quest.6101000000000005.quest_desc: [
		"A rotational network has stress capacity supplied by generators and stress impact consumed by machines. Speed and capacity are separate concerns; making an overloaded network faster is an impressively efficient way to remain overloaded."
		"Place a Stressometer on a shaft and read the network load. Add power capacity or divide the machinery into separate networks before the gauge reaches its limit."
		"Obtain a Stressometer. The task detects it without consuming it."
	]
	quest.6101000000000005.title: "Stress Is a Number, Conveniently"
	quest.6101000000000006.quest_desc: [
		"A Clutch stops rotation when given a redstone signal. A Gearshift reverses its output when signalled. They look similar because Create assumes you will read names before installing critical controls. Let us reward that optimism."
		"Wire each component to a lever and test it on an unloaded shaft. Use Clutches for shutdown and maintenance isolation; use Gearshifts when a machine or contraption genuinely needs reversal."
		"Obtain one Clutch and one Gearshift. The task detects them without consuming them."
	]
	quest.6101000000000006.title: "Stop, Reverse, Continue"
	quest.6101000000000007.quest_desc: [
		"Encased Chain Drives transfer the same rotational speed along a connected row. Place their chain faces beside one another and connect a shaft to any valid end."
		"They are useful for distributing synchronized rotation across several machines without constructing a decorative forest of exposed gears. Rotate a misplaced casing with a wrench; glaring at it is not an interaction."
		"Obtain 4 Encased Chain Drives. The task detects them without consuming them."
	]
	quest.6101000000000007.title: "Parallel Motion in a Proper Casing"
	quest.6101000000000008.quest_desc: [
		"Use a Belt Connector on one shaft, then on a second parallel shaft within range. The belt carries rotation and can transport items placed upon it. It requires two endpoints because it is a belt, not an article of faith."
		"Keep both shafts parallel, provide unobstructed space, and watch the placement preview. Funnels, tunnels, and processing machines can then interact with the moving items."
		"Obtain 8 Belt Connectors. The task detects them without consuming them."
	]
	quest.6101000000000008.title: "Two Shafts and a Belt—Yes, Both Shafts"
	quest.64B1D49B1BAE48D8.quest_desc: ["Bind water, reclaimed soil, composting, food, and medicine into the Habitation contribution. Use JEI for the exact pack recipe."]
	quest.64B1D49B1BAE48D8.title: "Habitation Charter"
	quest.67F7363108A8449B.quest_desc: [
		"Blackstone can replace ordinary stone in a furnace body when Nether material is easier to supply. Inspect the live recipe before hauling it home; I have altered enough recipes that memory is now a recreational hazard."
		"Obtain one Blackstone Furnace. The task detects it without consuming it; this is an optional regional alternative."
	]
	quest.67F7363108A8449B.title: "A Furnace From the Nether"
	quest.5B00000000000012.title: "Orbital Calibration"
	quest.5B00000000000012.quest_desc: [
		"Use extraterrestrial metals to finish calibrated Create Cybernetics-native implants. Cyber Ware Port hardware is a donor at this tier, never the installation authority."
		"The two examples represent the space-age branch; the remaining body-slot variants stay available through JEI."
	]
	quest.5B00000000000013.title: "Assemblies From the Dark"
	quest.5B00000000000013.quest_desc: [
		"Combine multiple cyberware ecosystems with recovered Darknet access material. These assemblies are parts, not implants, and cannot be installed by themselves."
	]
	quest.5B00000000000014.title: "A Body That Answers the Darknet"
	quest.5B00000000000014.quest_desc: [
		"Complete the Datavore Control Core and use it in a Create Cybernetics-native end-era implant. This is the end of the branch, not a second surgery system."
	]
	quest.6AFDB896C63FFE06.quest_desc: [
		"Deepslate provides another regional furnace body for deep settlements. Use the recipe shown by JEI, then place the furnace where fuel, inputs, and outputs can reach it without a pilgrimage."
		"Obtain one Deepslate Furnace. The task detects it without consuming it; this is an optional regional alternative."
	]
	quest.6AFDB896C63FFE06.title: "A Furnace From the Deep"
	quest.6B42333621782F13.quest_desc: [
		"Scrap metal is not an ingot. That is precisely why it matters. It is the common language of the ruins: found in vegetation, containers, garbage, and the remains of structural metal blocks."
		"Do not expect a single piece to transform your circumstances. Civilization begins when scattered refuse becomes a repeatable material stream."
	]
	quest.6B42333621782F13.title: "A Glint in the Refuse"
	quest.6DCA18395E0724FB.quest_desc: [
		"Leather, milk, beef, and breeding utility justify the higher price."
		"This exchange supplies one spawn egg and can be repeated."
	]
	quest.6DCA18395E0724FB.title: "Cow Spawn Egg - 1 Cog"
	quest.6DFA244D31C0E2BF.quest_desc: ["Build a composter and feed it plant matter. Dead bushes and ferns can support this loop; sticks cannot be composted."]
	quest.6DFA244D31C0E2BF.title: "Nothing Organic Is Waste"
	quest.6E01000000000001.quest_desc: [
		"Quartermaster stock: Torch Bundle - 4 Spurs; Bread Ration - 1 Bevel; Purified Water Reserve - 1 Bevel; Canned Food Case - 1 Bevel + 4 Spurs."
		"Medical and repair stock: Bandage Roll - 1 Bevel; Cordage Bundle - 1 Bevel; Leather Repair Stock - 1 Sprocket; Masonry Repair Pallet - 1 Bevel."
		"Rebuilding stock: Lumber Repair Pallet - 1 Bevel; Window Glass Crate - 1 Bevel; Charcoal Heating Reserve - 1 Bevel; limited Emergency Iron Pickaxe - 1 Sprocket."
		"This catalogue mirrors the physical vendor. Purchases occur through the Echo with physical Numismatics coins; default exchange rates apply and the Echo returns change. This terminal does not duplicate stock as quest rewards."
		"Try not to convert the entire emergency allocation into bread. I would prefer not to explain dietary variety during a famine."
	]
	quest.6E01000000000001.title: "Quartermaster — Lost Survivors"
	quest.6E01000000000002.quest_desc: [
		"Mechanist stock: Shafts - 1 Bevel; Cogwheels - 1 Bevel; Large Cogwheels - 1 Bevel; Belt Connectors - 1 Sprocket."
		"Workshop stock: Andesite Alloy - 1 Sprocket; Gearboxes - 1 Sprocket; Encased Chain Drives - 1 Sprocket; Andesite Casings - 1 Sprocket + 1 Bevel."
		"Handling stock: Andesite Funnels - 1 Sprocket; Chutes - 1 Sprocket; limited Super Glue - 2 Sprockets; limited Replacement Wrench - 2 Sprockets."
		"Prices use physical Numismatics coins at the default exchange rates, and the Echo returns change."
		"It sells replacement workshop parts, not a prefabricated factory. You will still have to connect the shafts to something, an indignity engineering has yet to eliminate."
	]
	quest.6E01000000000002.title: "Mechanist — Mechanical Reconstruction"
	quest.6E01000000000003.quest_desc: [
		"Foundry stock: Coal Coke - 1 Sprocket; Coal Coke Blocks - 1 Sprocket + 1 Bevel; Steel Ingots - 2 Sprockets; Cast Iron Sheets - 1 Sprocket + 1 Bevel."
		"Furnace stock: Blast Furnace Reinforcement - 2 Sprockets; Fireproof Bricks - 1 Sprocket + 1 Bevel; Cinder Blocks - 1 Sprocket; Industrial Concrete - 1 Sprocket + 1 Bevel."
		"Transport stock: Rails - 1 Sprocket; Powered Rails - 1 Sprocket + 1 Bevel; Steel Pipes - 1 Sprocket + 1 Bevel; Iron Bars - 1 Sprocket."
		"Prices use physical Numismatics coins at the default exchange rates, and the Echo returns change."
		"These are maintenance lots. The quantities are useful precisely because they cannot substitute for an operating foundry."
	]
	quest.6E01000000000003.title: "Foundry Broker — Heavy Industry"
	quest.6E01000000000004.quest_desc: [
		"Chemical stock: Rubber Sheets - 1 Sprocket + 1 Bevel; Plastic Sheets - 2 Sprockets; Sulfur Dust - 1 Sprocket + 1 Bevel; Salt Dust - 1 Sprocket."
		"Process stock: Caustic Soda - 1 Sprocket + 1 Bevel; limited Lubricant - 2 Sprockets + 1 Bevel; limited Emergency Gasoline - 1 Cog; Plastic Buckets - 1 Sprocket."
		"Pipework stock: Steel Process Pipes - 2 Sprockets; Steel Valves - 2 Sprockets; Glass Bottles - 1 Bevel; Empty Buckets - 1 Sprocket."
		"Prices use physical Numismatics coins at the default exchange rates, and the Echo returns change."
		"Crude oil is not sold. Locate the remote deposits, build a controlled wellhead, and refine the feedstock. Apparently the petroleum is unwilling to become infrastructure merely because we require it."
	]
	quest.6E01000000000004.title: "Chemical Cooperative — Petrochemical Civilization"
	quest.6E01000000000005.quest_desc: [
		"Grid stock: Copper Wire - 1 Sprocket + 1 Bevel; Insulated Wire - 2 Sprockets; Copper Cord - 1 Sprocket + 1 Bevel; Wire Connectors - 1 Sprocket + 1 Bevel."
		"Control stock: Sockets - 1 Sprocket + 1 Bevel; Fuse Holders - 1 Sprocket + 1 Bevel; Light Bulbs - 1 Sprocket; Redstone Relays - 2 Sprockets."
		"Electrical reserves: Circuit Boards - 2 Sprockets + 1 Bevel; limited Batteries - 3 Sprockets; Redstone - 1 Sprocket + 1 Bevel; limited ME Energy Acceptor - 1 Cog."
		"Prices use physical Numismatics coins at the default exchange rates, and the Echo returns change."
		"The stock repairs and extends a grid. It does not make exposed conductors sensible, though I admire your species' persistence in testing that distinction."
	]
	quest.6E01000000000005.title: "Grid Supply — The Electrical Grid"
	quest.6E01000000000006.quest_desc: [
		"Network stock: Certus Quartz - 1 Sprocket + 1 Bevel; Fluix Crystals - 2 Sprockets; Fluix Cable - 2 Sprockets; Logic Processors - 2 Sprockets + 1 Bevel."
		"Processor stock: Calculation Processors - 3 Sprockets; Engineering Processor - 3 Sprockets + 1 Bevel; paired Matter Transfer Cores - 1 Cog; Blank Patterns - 2 Sprockets."
		"Automation stock: Basic Upgrade Cards - 2 Sprockets; Speed Cards - 3 Sprockets; Machine Cores - 3 Sprockets; Item Pipes - 2 Sprockets."
		"Prices use physical Numismatics coins at the default exchange rates, and the Echo returns change."
		"These components reduce replacement tedium. They do not teach channel planning, power budgeting, or autocrafting; fortunately, I remain available for those."
	]
	quest.6E01000000000006.title: "Systems Exchange — Automated Industry"
	quest.6E01000000000007.quest_desc: [
		"Protective stock: limited Hazmat Suit - 2 Cogs + 2 Sprockets; limited Gas Mask - 1 Cog; Gas Mask Filters - 2 Sprockets; Radiation Recovery Doses - 2 Sprockets + 1 Bevel."
		"Containment stock: Anti-Radiation Pills - 3 Sprockets; Boric Acid - 2 Sprockets; Lead Plating - 1 Cog; Hazard Concrete - 3 Sprockets."
		"Recovery stock: Medical Bandages - 1 Sprocket + 1 Bevel; Decontamination Milk - 1 Sprocket + 1 Bevel; Golden Apples - 2 Sprockets + 1 Bevel; limited Geiger Counter - 1 Cog."
		"Prices use physical Numismatics coins at the default exchange rates, and the Echo returns change."
		"Protective equipment changes the outcome of an accident. It does not redefine the accident as a successful operating procedure."
	]
	quest.6E01000000000007.title: "Containment Office — High Energy Engineering"
	quest.6E01000000000008.quest_desc: [
		"Life-support stock: Oxygen Tank - 3 Sprockets; limited Large Oxygen Tank - 1 Cog + 2 Sprockets; Fluid Cells - 2 Sprockets; Orbital Batteries - 1 Cog."
		"Construction stock: Cables - 2 Sprockets + 1 Bevel; Iron Plating - 1 Cog; Heavy Metal Plates - 1 Cog; Desh Ingots - 1 Cog."
		"Expedition stock: Desh Plating - 1 Cog + 2 Sprockets; Cosmo Bread - 1 Sprocket + 1 Bevel; limited Orbital Solar Panel - 1 Cog + 3 Sprockets; limited Replacement Space Suit - 3 Cogs."
		"Prices use physical Numismatics coins at the default exchange rates, and the Echo returns change."
		"Check the manifest before launch. Discovering that oxygen was optional after leaving the atmosphere produces a very brief educational experience."
	]
	quest.6E01000000000008.title: "Expedition Exchange — Orbital Industry"
	quest.6E01000000000009.quest_desc: [
		"Clinic stock: Actuator Pair - 2 Sprockets; Fiberoptic Pair - 2 Sprockets; Wiring Bundle - 2 Sprockets; Diode Pair - 2 Sprockets."
		"Medical fabrication stock: Plating Pair - 2 Sprockets + 1 Bevel; Synthetic Nerve Pair - 3 Sprockets."
		"Donor salvage: Frayed Neural Bus - 1 Sprocket + 1 Bevel; Cracked Optic Array - 1 Sprocket + 1 Bevel; Arrhythmic Pump Core - 2 Sprockets; Torn Myomer Bundle - 2 Sprockets; Warped Frame Strut - 2 Sprockets; Delaminated Dermis - 2 Sprockets."
		"This catalogue mirrors the physical vendor. Purchases use physical Numismatics coins at the default exchange rates, and the Echo returns change. Calibrated, orbital, and Darknet implants are deliberately craft-only."
		"Replacement stock supports a clinic. It does not confer medical judgment, sterile technique, or consent."
	]
	quest.6E01000000000009.title: "Cybernetics Exchange - Automated Clinic"
	quest.6E32591D7E88B06E.quest_desc: ["Combine nine coarse dirt with a water bucket to make clay. Check JEI for the exact shaped or shapeless arrangement; the bucket is returned."]
	quest.6E32591D7E88B06E.title: "Coarse Earth Into Clay"
	quest.6E9254D8E1EA2EF0.quest_desc: ["Craft the Mason contribution after completing the stone-compression route. Use JEI on the contribution item for the exact pack recipe; this charter is one route to the furnace capstone."]
	quest.6E9254D8E1EA2EF0.title: "The Mason's Firebox"
	quest.6FFD2EE5BCA2FE23.quest_desc: ["Recover radioactive waste from the wasteland. It can be hammered and sieved through custom loot tables; every valid sieve attempt should produce at least one result."]
	quest.6FFD2EE5BCA2FE23.title: "Waste That Still Has Value"
	quest.71FEE0B9CC3C6CDE.quest_desc: [
		"Nine pieces of Wastelands scrap can be consolidated into a Scrap Pile. The pile is not merely storage: it is a processable salvage input."
		"Once you possess a sieve and mesh, Scrap Piles can yield garbage bags, empty cans, paper, string, sticks, and—through better meshes—rarer industrial remnants."
	]
	quest.71FEE0B9CC3C6CDE.title: "Concentrated Poverty"
	quest.7AEA71F2018293E3.quest_desc: ["Bind scrap recovery, sieving, garbage bags, and hazardous-waste processing into the Scavenger contribution. Use JEI for the exact recipe."]
	quest.7AEA71F2018293E3.title: "Scavenger Charter"
	quest.7C49923166C82685.quest_desc: [
		"Build a Stove as the heat source for a proper kitchen. Place the Cooking Pot above it and keep the front accessible for fuel and finished meals."
		"A campfire can keep one survivor fed. A workstation kitchen supports shifts, recipes, and storage—which is why civilizations tend not to arrange dinner directly on the floor."
		"Obtain one Stove. The task detects it without consuming it; this support lesson does not gate the era."
	]
	quest.7C49923166C82685.title: "A Real Kitchen"
	quest.7C769C875E87672B.quest_desc: [
		"A 3x compressed cobblestone block contains 729 ordinary cobblestone. The first furnace requires eight of them: 5,832 cobblestone in total."
		"This is not household crafting. It is the first communal construction project. Divide quarrying, hammering, hauling, food, security, and processing among your settlement."
	]
	quest.7C769C875E87672B.title: "The Weight of Industry"
	quest.7D194089522507AB.quest_desc: ["You are alive in a ruined and hostile world. This field terminal is both your manual and your route through Infinite Domain. The central path teaches what you need to survive; the briefing on the left introduces me, the world you have entered, and the work waiting beyond this shelter." "Read this page, claim the emergency ration, and use the checkmark below."]
	quest.7D194089522507AB.quest_subtitle: "A field manual for an impossible recovery"
	quest.7D194089522507AB.title: "Another Lost Soul"
	quest.E110000000000001.quest_desc: [
		"The furnace proved that survivors can build together. Now the settlement must turn isolated labor into repeatable systems."
		"Three routes advance this era: Mining and Extraction, Farming and Biological Production, or Exploration and Recovery. Any one can forge the Mechanical Foundation Core; ancillary quests teach the machines that make every route stronger."
		"Specialize without isolating yourselves. Ore, food, and recovered knowledge are separate streams, but civilization exists where they meet."
	]
	quest.E110000000000001.title: "Era 1: Mechanical Reconstruction"
	quest.E110000000000002.quest_desc: [
		"Craft a Mechanical Foundation Core with any one completed professional charter. Mining, Farming, and Exploration are equal progression routes; the unchosen branches remain available for allies and later development."
		"The core proves your settlement can sustain its first machinery, organize a renewable supply, or project useful work beyond its walls. Era 2 will demand heavy industry on a far larger scale."
	]
	quest.E110000000000002.title: "The Mechanical Foundation"
	task.1F5F4975B2EC3E7B.title: "Acknowledge me"
	task.29B274508EC16845.title: "Establish a survivable shelter"
	task.2F1F0A5F6F6B937B.title: "Find an Undead"
	task.6B00000000000010.title: "Obtain 21 × Virtual Machine Casing"
	task.6B00000000000011.title: "Obtain 1 × Virtual Machine Core"
	task.6B00000000000012.title: "Obtain 1 × Wrench"
	task.6B00000000000013.title: "Obtain 1 × Terminal"
	task.6B00000000000014.title: "Enter Cyberspace"
	task.6E02000000000001.title: "Review the Quartermaster exchange"
	task.6E02000000000002.title: "Review the Mechanist exchange"
	task.6E02000000000003.title: "Review the Foundry Broker exchange"
	task.6E02000000000004.title: "Review the Chemical Cooperative exchange"
	task.6E02000000000005.title: "Review the Grid Supply exchange"
	task.6E02000000000006.title: "Review the Systems Exchange"
	task.6E02000000000007.title: "Review the Containment Office exchange"
	task.6E02000000000008.title: "Review the Expedition Exchange"
	task.6E02000000000009.title: "Review the Cybernetics Exchange"
	task.E120000000000001.title: "Review the three Era 1 routes"
	chapter.1C7E40C69A25D8F4.title: "Undead Settlement Automation"
	chapter.1C7E40C69A25D8F4.subtitle: "Convert hostile remains into controlled settlement production"
	quest.5D10000000000001.quest_desc: [
		"Era 5 begins to automate labor as well as machines. A Soul Well establishes an autonomous undead settlement and is therefore a civilization system, not an early survival shortcut."
		"Obtain one Soul Well. Its first placement asks for a surface village or subterranean catacomb; that choice remains committed until the well is broken and placed again."
		"Keep this specialization optional. The main era routes must remain completable without undead labor."
	]
	quest.5D10000000000001.title: "A Workforce That Does Not Sleep"
	quest.5D10000000000002.quest_desc: [
		"Village Stone proves that the settlement has a material language of its own rather than being a disguised vanilla village."
		"Obtain one Village Stone and reserve a surveyed build area around the Soul Well. Do not place the well beside machinery, storage, or terrain you are unwilling to have reorganized."
	]
	quest.5D10000000000002.title: "Choose the Shape of the Dead"
	quest.5D10000000000003.quest_desc: [
		"ZV-Houses is the required construction library behind Zombie Village. Its blueprints are working plans that the settlement consumes as instructions."
		"Prepare four blank Blueprints. Use a stonecutter to select the structure plan carried by each sheet."
	]
	quest.5D10000000000003.title: "Plans Before Labor"
	quest.5D10000000000004.quest_desc: [
		"Begin with one small, auditable structure before commissioning a district. A Cottage Blueprint tests material delivery, access, and the settlement's ability to finish a bounded job."
		"Obtain one Cottage Blueprint, then watch the actual build for shortages and unsafe terrain instead of assuming possession proves the system works."
	]
	quest.5D10000000000004.title: "A Roof for the First Crew"
	quest.5D10000000000005.quest_desc: [
		"Automation becomes civilization only when it can support food and water. Pair a Farm Blueprint with a Rain Barrel before expanding the population."
		"The terminal detects both items without consuming them. Place water infrastructure where pathing can reach it and where contamination cannot spread into ordinary stores."
	]
	quest.5D10000000000005.title: "Food Beyond the Living"
	quest.5D10000000000006.quest_desc: [
		"A durable settlement needs repair capacity. Commission a Blacksmith Blueprint and a Stone Hearth as the first specialist workshop."
		"This is a sidegrade to the automated factory, not a replacement for the Era 5 machine chain."
	]
	quest.5D10000000000006.title: "Tools for the Silent Shift"
	quest.5D10000000000007.quest_desc: [
		"Unbounded gathering merely relocates disorder. Add a Warehouse Blueprint and eight shelves so outputs have an accountable destination."
		"Separate construction stock, food, weapons, and recovered salvage. If every item enters one pile, the settlement has not become logistics."
	]
	quest.5D10000000000007.title: "A Warehouse With Hands"
	quest.5D10000000000008.quest_desc: [
		"Soul Interfaces let hoppers, pipes, and storage networks deposit into and withdraw from a Soul Well without repeatedly opening or dismantling its core."
		"Obtain two interfaces and use them as controlled import and export boundaries. Completing this milestone closes the Era 5 settlement-automation section."
	]
	quest.5D10000000000008.title: "Inventory Without Desecration"
	quest.5D10000000000009.quest_desc: [
		"Era 6 infrastructure can support a subterranean district. A Stairwell Blueprint provides deliberate access instead of an improvised shaft through occupied construction cells."
		"Obtain one Stairwell Blueprint. Keep reactor, contaminated, and biological spaces outside the settlement's autonomous build envelope."
	]
	quest.5D10000000000009.title: "The Catacomb Standard"
	quest.5D1000000000000A.quest_desc: [
		"Growth without habitation creates pathing congestion and exposed workers. Commission a Dormitory Blueprint before assigning more specialized roles."
		"Obtain one Dormitory Blueprint and verify that doors, beds, and travel routes remain accessible after construction."
	]
	quest.5D1000000000000A.title: "House the Growing Shift"
	quest.5D1000000000000B.quest_desc: [
		"A Library Blueprint establishes a place for records, cartography, and recovered knowledge inside the settlement."
		"Obtain one Library Blueprint. Treat the building as infrastructure for future exploration branches rather than decorative completion."
	]
	quest.5D1000000000000B.title: "Memory Among the Dead"
	quest.5D1000000000000C.quest_desc: [
		"An autonomous workforce attracts threats and can create them when poorly contained. A Barracks Blueprint gives guards a deliberate station and keeps weapons out of general storage."
		"Obtain one Barracks Blueprint and establish a perimeter that does not send defenders through farms or workshops."
	]
	quest.5D1000000000000C.title: "Defend the Works"
	quest.5D1000000000000D.quest_desc: [
		"A Town Hall Blueprint marks the change from a work camp to governed infrastructure. Storage, habitation, defense, and specialist buildings should now form one legible plan."
		"Obtain one Town Hall Blueprint. This closes the Era 6 municipal section without making it part of the nuclear capstone."
	]
	quest.5D1000000000000D.title: "Municipal Command"
	quest.5D1000000000000E.quest_desc: [
		"Soul Gates dispatch labor beyond the local settlement. Their default gatherable list includes exposed ore veins and generated containers, making them powerful enough to bypass earlier mining and scavenging loops."
		"For that reason the pack requires Era 7 Desh and compressed blackstone to craft a gate. Obtain one only after orbital industry is open."
	]
	quest.5D1000000000000E.title: "Remote Labor Is Orbital Logistics"
	quest.5D1000000000000F.quest_desc: [
		"A remote route needs two ends and controlled inventory boundaries. Prepare two Soul Gates and two Soul Interfaces before treating gate labor as dependable freight."
		"Test the route with ordinary construction material first. Do not make unique loot, quest artifacts, or irreplaceable equipment the first cargo."
	]
	quest.5D1000000000000F.title: "A Gate Needs a Return Path"
	quest.5D10000000000010.quest_desc: [
		"Demonstrate a small distributed settlement network: four Soul Gates backed by documented town-hall and warehouse plans."
		"Gate labor can harvest ores, containers, crops, and structural resources. Use it as late logistics capacity; it does not retroactively satisfy the work or knowledge represented by earlier era quests."
		"The terminal detects the submitted design inventory without consuming it. This optional charter does not unlock an ordinary era."
	]
	quest.5D10000000000010.title: "Undead Settlement Charter"
	chapter.1C7E40C69A25D8F5.title: "Environmental Survival Engineering"
	chapter.1C7E40C69A25D8F5.subtitle: "Atmosphere, radiation, ventilation, exposure, and controlled work zones"
	quest.5D20000000000001.quest_desc: [
		"EnviroMine Lite is active. Toxic cave air begins below Y=63; sanity loss, lung damage, burning coal, and ventilation all remain enabled, and these rules are not restricted to the Overworld."
		"Read the environmental indicators before descending. This acknowledgment carries no reward and does not certify that the air is safe."
	]
	quest.5D20000000000001.title: "The Air Is Part of the Mine"
	quest.5D20000000000002.quest_desc: [
		"EnviroMine Lite makes air quality, lung damage, and protective breathing equipment part of survival."
		"Make a Basic Gas Mask before long underground work. It is an emergency respirator assembled from leather, glass, bundled paper, and a coal block—not permission to ignore exposure."
		"Objective: obtain 1 × Basic Gas Mask. The terminal detects this item without consuming it."
	]
	quest.5D20000000000002.title: "Something Between You and the Dust"
	quest.5D20000000000003.quest_desc: [
		"Respiratory protection is consumable capacity. Establish a reserve of replaceable Air Filters before the first mask becomes an irreplaceable single point of failure."
		"Objective: obtain 4 × Air Filter. The terminal detects these items without consuming them."
	]
	quest.5D20000000000003.title: "Filters Are Supplies"
	quest.5D20000000000004.quest_desc: [
		"A Hard Hat provides dedicated mine equipment and illumination for inspecting vents, hot coal, and escape routes. It does not replace respiratory protection."
		"Objective: obtain 1 × Hard Hat. The terminal detects this item without consuming it."
	]
	quest.5D20000000000004.title: "Light Where the Air Fails"
	quest.5D20000000000005.quest_desc: [
		"Build EnviroMine's PDA and use its readings as operating information. Symptoms are late warnings; instrumentation is the earlier one."
		"Objective: obtain 1 × PDA. The terminal detects this item without consuming it."
	]
	quest.5D20000000000005.title: "Measure Before the Headache"
	quest.5D20000000000006.quest_desc: [
		"Replace the improvised respirator with the full Gas Mask and a planned filter stock. Keep a clean retreat route because protection can still be exhausted."
		"Objective: obtain 1 × Gas Mask. The terminal detects this item without consuming it."
	]
	quest.5D20000000000006.title: "A Working Respiratory Standard"
	quest.5D20000000000007.quest_desc: [
		"Ventilation is infrastructure, not a block placed beside a miner. Manufacture enough vertical pipe for a meaningful gallery run; horizontal and omnidirectional variants can be converted from the base pipe."
		"Objective: obtain 16 × Ventilation Pipe. The terminal detects these items without consuming them."
	]
	quest.5D20000000000007.title: "Give the Air a Route"
	quest.5D20000000000008.quest_desc: [
		"The intake defines where replacement air comes from. Place it where the source is actually clean, protected, and serviceable instead of recirculating the same poisoned chamber."
		"Objective: obtain 1 × Ventilation Intake. The terminal detects this item without consuming it."
	]
	quest.5D20000000000008.title: "Clean Air Must Begin Somewhere"
	quest.5D20000000000009.quest_desc: [
		"Build the powered Ventilation Unit that drives the network. Its compressed-iron cost places permanent clean-air infrastructure in the Electrical era rather than the first night."
		"Objective: obtain 1 × Ventilation Unit. The terminal detects this item without consuming it."
	]
	quest.5D20000000000009.title: "Mechanical Lungs for the Works"
	quest.5D2000000000000A.quest_desc: [
		"Combine hard-hat protection, replaceable filters, and advanced materials into an Advanced Gas Mask for industrial and expedition work."
		"Objective: obtain 1 × Advanced Gas Mask. The terminal detects this item without consuming it."
	]
	quest.5D2000000000000A.title: "The Advanced Breathing Standard"
	quest.5D2000000000000B.quest_desc: [
		"Commission one real ventilation circuit: clean-source intake, powered unit, connected pipe run, a monitored work face, and an unobstructed retreat route. Verify improved readings at the work face with the PDA."
		"This operating test cannot be measured reliably by an inventory task. Check it only after the placed system works; the checkmark itself gives no reward."
	]
	quest.5D2000000000000B.title: "Commission the Mine Gallery"
	quest.5D2000000000000C.quest_desc: [
		"Enter a southern Sulfuric Valley carrying the advanced mask, spare filters, the PDA, and a marked retreat bearing. Treat visual clarity as unrelated to air safety."
		"Objective: visit Sulfuric Valley. The terminal detects the biome at your position automatically."
	]
	quest.5D2000000000000C.title: "The Sulfur Has No Warning Label"
	quest.5D2000000000000D.quest_desc: [
		"Deploy the same environmental discipline beyond the Ancient City gate. EnviroMine is not limited to the Overworld, and the lava-ocean Nether is not made safe merely because fire is the obvious hazard."
		"Objective: visit The Nether after commissioning a ventilation circuit."
	]
	quest.5D2000000000000D.title: "Air Doctrine Beyond the Gate"
	quest.5D2000000000000E.quest_desc: [
		"Retain a functioning PDA and Advanced Gas Mask after completing both the sulfuric and Nether deployments. This optional standard records an operational environmental-safety program, not immunity from exposure."
		"Objective: hold both instruments. The terminal detects them without consuming them."
	]
	quest.5D2000000000000E.title: "Environmental Safety Charter"
	quest.5D2000000000000F.quest_desc: [
		"The Wasteland's radiation system is enabled. Exposure is checked every 100 ticks, dose persists on the player, nearby radioactive waste adds four units per check, and natural recovery is slower than exposure."
		"Avoidance comes first: limit time near waste, maximize distance, leave contaminated biomes, use shelter, monitor dose, and prepare protective equipment. A recovery drug is not armor."
	]
	quest.5D2000000000000F.title: "The Invisible Weather"
	quest.5D20000000000010.quest_desc: [
		"Campfire-cook ordinary logs, decayed logs, or decayed wood for 15 seconds to recover Wasteland rubber. Yes, the first radiation-protection material begins with a campfire rather than a refinery."
		"Prepare eight Rubber now. The complete suit eventually uses seventeen, so preserve additional output instead of treating it as fuel."
	]
	quest.5D20000000000010.title: "Rubber From the Campfire"
	quest.5D20000000000011.quest_desc: [
		"Craft two Radiation Resistance Pills from two sugar, a honey bottle, and a small flower. Take preventive medicine before a planned exposure and verify its effect timer; it does not remove an accumulated dose."
		"Objective: obtain 2 × Radiation Resistance Pill. The terminal detects these items without consuming them."
	]
	quest.5D20000000000011.title: "Prevention Before Exposure"
	quest.5D20000000000012.quest_desc: [
		"Keep RadAway for exposure that has already occurred. Craft it from a Filter Canister, honey, a redstone block, and glow berries, or recover limited doses through the hazardous-salvage sieve routes."
		"RadAway is recovery medicine, not permission to remain beside radioactive waste. Objective: obtain 2 × Rad Away."
	]
	quest.5D20000000000012.title: "RadAway Is Not a Shield"
	quest.5D20000000000013.quest_desc: [
		"Build the Wastelands Geiger Counter once the mechanical era supplies compressed copper and redstone. A held counter reports radiation audibly; turn uncertainty into a retreat decision before symptoms make it obvious."
		"Objective: obtain 1 × Geiger Counter. The terminal detects this item without consuming it."
	]
	quest.5D20000000000013.title: "Measure the Dose"
	quest.5D20000000000014.quest_desc: [
		"A slime ball, two sugar, and a small flower produce two Radiation Immunity Pills. Treat the displayed effect as temporary mission protection, confirm the remaining duration, and keep an uncontaminated return route."
		"Objective: obtain 2 × Radiation Immunity Pill. The terminal detects these items without consuming them."
	]
	quest.5D20000000000014.title: "Temporary Immunity, Permanent Caution"
	quest.5D20000000000015.quest_desc: [
		"Use the campfire rubber with lead plates, filters, tinted glass, and dye to assemble the complete Wasteland Hazmat Suit. Partial armor leaves the protection program partial as well."
		"Objective: obtain the Hazmat Suit helmet, chestplate, leggings, and boots together. The terminal does not consume them."
	]
	quest.5D20000000000015.title: "Seventeen Pieces of Rubber Between You and Regret"
	quest.5D20000000000016.quest_desc: [
		"Manufacture Lead Plating for a marked shelter, medicine locker, dirty-equipment boundary, and controlled approach to radioactive storage. Equipment protects workers; containment reduces how often protection is tested."
		"Objective: obtain 8 × Lead Plating. The terminal detects these blocks without consuming them."
	]
	quest.5D20000000000016.title: "Build Distance Into the Walls"
	quest.5D20000000000017.quest_desc: [
		"Write a short radiation procedure your team can actually follow: monitor before entry, set a time limit, identify the clean exit, separate dirty equipment, carry preventive and recovery medicine, and forbid lone reentry after an alarm."
		"Acknowledge this only after the route and supplies exist. It is an unrewarded operating check, not a substitute for the equipment quests above."
	]
	quest.5D20000000000017.title: "The Exposure-Control Drill"
	chapter.1C7E40C69A25D8F6.title: "Parallel Factory Paths"
	chapter.1C7E40C69A25D8F6.subtitle: "Optional industrial systems that complement rather than replace the era spine"
	quest.5D30000000000001.title: "A Factory Must Grow"
	quest.5D30000000000001.quest_desc: [
		"Create is the foundational factory language. Immersive Engineering grows from it into permanent plants, bulk fluids, long-distance wire networks, and heavy multiblocks."
		"IE is an advanced alternative for jobs that benefit from scale and permanence, not a replacement for Create. This optional specialization never gates the main era ladder."
	]
	quest.5D30000000000002.title: "The Reconfigurable Line"
	quest.5D30000000000002.quest_desc: [
		"Retain a Mechanical Press, Mechanical Mixer, and Basin as the core of the Create factory path. Shafts and belts let this cell be rerouted as needs change."
		"Create Ultimate Factory adds routes to existing Create machinery; it does not add a separate family of factory blocks."
	]
	quest.5D30000000000003.title: "Stone Without a Quarry"
	quest.5D30000000000003.quest_desc: [
		"Use added compacting routes to produce tuff from cobblestone and lava, calcite from gravel and bone meal, and deepslate from stone and lava. Make eight of each as a renewable construction trial."
		"Natural finds satisfy detection, but run the Basin recipes before calling them factory outputs."
	]
	quest.5D30000000000004.title: "An Industrial Palette"
	quest.5D30000000000004.quest_desc: [
		"Compact gravel with zinc, iron, gold, and copper feedstocks to manufacture Asurine, Crimsite, Ochrum, and Veridium. These are repeatable building aggregates, not ore multiplication."
		"Produce four of each for color-coded production districts, retaining walls, or service tunnels."
	]
	quest.5D30000000000005.title: "Crushing for Recovery"
	quest.5D30000000000005.quest_desc: [
		"Install a matched pair of Crushing Wheels. The safe added routes recover mushrooms from mushroom blocks and bone meal from dead coral without creating strategic materials from nothing."
		"Run at least one recovery batch and route its byproducts instead of allowing loose outputs."
	]
	quest.5D30000000000006.title: "Nether Reclamation Line"
	quest.5D30000000000006.quest_desc: [
		"After the Ancient City gate opens, reclaim Nether materials: crush crying obsidian for powdered obsidian and soul sand for occasional glowstone dust."
		"Cheap blaze, diamond, Heart of the Sea, netherite-scrap, and chorus-fruit shortcuts are retired because they bypass exploration and era progress."
	]
	quest.5D30000000000007.title: "A Furnace Built as a Building"
	quest.5D30000000000007.quest_desc: [
		"Immersive Engineering begins here as the fixed-plant counterpart to Create's rearrangeable workshops."
		"Prepare twenty-seven Coke Bricks, form the 3 × 3 × 3 Coke Oven with the Engineer's Hammer, and carbonize coal into coke and creosote."
		"This begins the transition from rearrangeable Create cells to fixed continuous plants."
	]
	quest.5D30000000000008.title: "Creosote Becomes Structure"
	quest.5D30000000000008.quest_desc: [
		"Use the Coke Oven's creosote to treat wood, then retain the Engineer's Hammer used to form and maintain IE multiblocks."
		"Keep creosote in dedicated storage so the first byproduct cannot stop coke production."
	]
	quest.5D30000000000009.title: "Belts and Pipes at Plant Scale"
	quest.5D30000000000009.quest_desc: [
		"Convert eight Create Belt Connectors around an Industrial Engineering Core into eight IE Basic Conveyors, then prepare eight fluid pipes and a valve. IE conveyors suit compact fixed layouts while pipes establish deliberate fluid boundaries."
		"A Basic Conveyor can be crafted back into one Belt Connector. Advanced IE conveyor variants remain engineered parts and are not included in this exchange."
		"Use valves at isolation points. A plant that cannot be serviced without dismantling its network is unfinished."
	]
	quest.5D3000000000000A.title: "The Mechanism Inside the Masonry"
	quest.5D3000000000000A.quest_desc: [
		"Use Create sequenced assembly to combine a Simulated Gyroscopic Mechanism, Create Precision Mechanism, and TFMG Steel Mechanism into an Industrial Engineering Core."
		"Basic, Light, and Heavy Engineering Blocks all consume this core. Every major IE multiblock therefore inherits factory capability proven through Create and TFMG."
	]
	quest.5D3000000000000B.title: "Commission the Metal Press"
	quest.5D3000000000000B.quest_desc: [
		"Form and operate an IE Metal Press. Fit a mold, pass one controlled batch through it, and verify input and output handling before checking this milestone."
		"Use it for steady standardized components; retain Create presses where flexible sequencing or kinetic integration is more valuable."
	]
	quest.5D3000000000000C.title: "A Measured Low-Voltage Grid"
	quest.5D3000000000000C.quest_desc: [
		"Establish an IE low-voltage cell with copper wire, an LV connector, an LV accumulator, and an Engineer's Multimeter. It supports the main electrical systems instead of replacing them."
		"Measure demand, buffer intermittent loads, and keep exposed connectors away from walkways."
	]
	quest.5D3000000000000D.title: "Plant Oil and Fermentation"
	quest.5D3000000000000D.quest_desc: [
		"Form a Squeezer and Fermenter as parallel feedstock plants. The Squeezer extracts plant oil; the Fermenter produces ethanol. Both streams feed biodiesel refining."
		"Create prepares and routes crops into the fixed IE plants, making this the first deliberate crossover line."
	]
	quest.5D3000000000000E.title: "Commission the Refinery"
	quest.5D3000000000000E.quest_desc: [
		"Form the IE Refinery, connect separate plant-oil and ethanol inputs, provide buffered power, and collect biodiesel in isolated storage."
		"Run a real batch before checking this milestone. A formed shell with crossed pipes or no product tank is not commissioned."
	]
	quest.5D3000000000000F.title: "Fuel Must Answer to Load"
	quest.5D3000000000000F.quest_desc: [
		"Commission a Diesel Generator after the electrical era opens. Feed it from the tested refinery and prove it can carry a known plant load."
		"Use biodiesel as dispatchable power for heavy work and recovery, not wasteful continuous generation when renewable or grid power can carry the base load."
	]
	quest.5D30000000000010.title: "Agriculture Inside the Works"
	quest.5D30000000000010.quest_desc: [
		"Build a Garden Cloche and retain industrial hemp seed. The cloche turns power and water into predictable critical industrial crops."
		"Protected production supports settlement farms rather than invalidating them."
	]
	quest.5D30000000000011.title: "Commission the Excavator"
	quest.5D30000000000011.quest_desc: [
		"After automated industry, survey a mineral vein and form an Excavator with its Bucket Wheel. Route power, output, and overflow before starting it."
		"The Excavator handles bulk regional extraction; Create contraptions remain preferable for selective or movable work."
	]
	quest.5D30000000000012.title: "Commission the Arc Furnace"
	quest.5D30000000000012.quest_desc: [
		"Form and operate the Arc Furnace with graphite electrodes, buffered energy, input segregation, slag handling, and output storage."
		"Use it for sustained batches. Small or frequently changing jobs still belong on flexible Create lines or other era machines."
	]
	quest.5D30000000000013.title: "High Voltage, High Consequence"
	quest.5D30000000000013.quest_desc: [
		"Prepare steel HV wire, an HV connector, and an HV transformer after Era 6. Transform voltage explicitly before feeding lower-tier consumers."
		"Keep HV corridors physically separated, switched, and measured. A wire that reaches a machine is not automatically a safe grid."
	]
	quest.5D30000000000014.title: "Create Feeds the Fixed Plant"
	quest.5D30000000000014.quest_desc: [
		"Use Create to meter, mix, wash, crush, or compact feedstock, then hand it through controlled storage into an IE bulk process. Return the output to shared logistics."
		"Check this only after the handoff runs without loose items, crossed fluids, or starvation."
	]
	quest.5D30000000000015.title: "Design for Failure, Not Just Speed"
	quest.5D30000000000015.quest_desc: [
		"Stop the Create drive and prove the IE plant isolates safely; interrupt the IE grid and prove the kinetic workshop can still perform essential repairs and handling."
		"Document process ownership, buffers, and restart order. This operating check carries no reward."
	]
	quest.5D30000000000016.title: "Parallel Factory Charter"
	quest.5D30000000000016.quest_desc: [
		"Retain a Mechanical Press, Engineer's Multimeter, and eight IE fluid pipes after commissioning both paths. They represent flexible processing, measured power, and controlled bulk fluids."
		"This charter recognizes complementary routes rather than duplicate machines and remains an optional specialization."
	]

	quest.6010000000000001.title: "Era 0 Mastery Project"
	quest.6010000000000001.quest_desc: ["Mastery is an optional civilization-scale sink. Each of the four branches requires 2,097,151 submitted items." "Every item task consumes its submissions. Deposit only resources the team has deliberately committed; these quests never unlock an ordinary era and can be ignored forever." "The target is derived from the signed 32-bit ceiling after reserving two safety bits, then stepping backward one bit for every earlier era." ]
	task.6050000000000001.title: "Acknowledge the consumptive mastery contract"
	quest.1040000000000001.title: "A Forest of Sticks"
	quest.1040000000000001.quest_desc: ["Submit the primitive handles, braces, kindling, and frames on which the first survivors depended." "Submit and permanently consume 2,097,151 units. Progress is shared with the quest team." ]
	quest.2040000000000001.title: "The Ruins Made Countable"
	quest.2040000000000001.quest_desc: ["Submit enough scavenged metal to prove the dead cities can support organized recovery." "Submit and permanently consume 2,097,151 units. Progress is shared with the quest team." ]
	quest.3040000000000001.title: "A Continent of Bad Soil"
	quest.3040000000000001.quest_desc: ["Submit the hostile surface material from which living soil had to be rebuilt." "Submit and permanently consume 2,097,151 units. Progress is shared with the quest team." ]
	quest.4040000000000001.title: "The First Mountain Removed"
	quest.4040000000000001.quest_desc: ["Submit the stone that once made a single furnace feel impossible." "Submit and permanently consume 2,097,151 units. Progress is shared with the quest team." ]
	quest.6010000000000002.title: "Master of Era 0"
	quest.6010000000000002.quest_desc: ["The settlement has consumed 2,097,151 units from each of four defining resource streams: 8,388,604 submitted items in total." "The final reward includes a deliberately uncraftable creative-mode artifact. This is extraordinary power earned through an optional, extraordinary resource sink." ]
	task.6050000000000002.title: "Accept the Era 0 Mastery Emblem"

	chapter.7100000000000000.title: "Era 1 Mastery — Mechanical Reconstruction"
	chapter.7100000000000000.subtitle: "Optional civilization-scale proof of mechanical abundance"
	quest.6110000000000001.title: "Era 1 Mastery Project"
	quest.6110000000000001.quest_desc: ["Mastery is an optional civilization-scale sink. Each of the four branches requires 4,194,303 submitted items." "Every item task consumes its submissions. Deposit only resources the team has deliberately committed; these quests never unlock an ordinary era and can be ignored forever." "The target is derived from the signed 32-bit ceiling after reserving two safety bits, then stepping backward one bit for every earlier era." ]
	task.6150000000000001.title: "Acknowledge the consumptive mastery contract"
	quest.1140000000000001.title: "Andesite Without Horizon"
	quest.1140000000000001.quest_desc: ["Submit the mechanical age's foundational stone." "Submit and permanently consume 4,194,303 units. Progress is shared with the quest team." ]
	quest.2140000000000001.title: "Alloy by the Nation"
	quest.2140000000000001.quest_desc: ["Submit the alloy that connected stone-age labor to controlled machinery." "Submit and permanently consume 4,194,303 units. Progress is shared with the quest team." ]
	quest.3140000000000001.title: "Grain for Every Gear"
	quest.3140000000000001.quest_desc: ["Submit the harvest that kept the first mechanical work crews alive." "Submit and permanently consume 4,194,303 units. Progress is shared with the quest team." ]
	quest.4140000000000001.title: "Salvage Without End"
	quest.4140000000000001.quest_desc: ["Submit concentrated ruins in quantities no lone scavenger could imagine." "Submit and permanently consume 4,194,303 units. Progress is shared with the quest team." ]
	quest.6110000000000002.title: "Master of Era 1"
	quest.6110000000000002.quest_desc: ["The settlement has consumed 4,194,303 units from each of four defining resource streams: 16,777,212 submitted items in total." "The final reward includes a deliberately uncraftable creative-mode artifact. This is extraordinary power earned through an optional, extraordinary resource sink." ]
	task.6150000000000002.title: "Accept the Era 1 Mastery Emblem"

	chapter.7200000000000000.title: "Era 2 Mastery — Heavy Industry"
	chapter.7200000000000000.subtitle: "Optional civilization-scale proof of heavy-industrial abundance"
	quest.6210000000000001.title: "Era 2 Mastery Project"
	quest.6210000000000001.quest_desc: ["Mastery is an optional civilization-scale sink. Each of the four branches requires 8,388,607 submitted items." "Every item task consumes its submissions. Deposit only resources the team has deliberately committed; these quests never unlock an ordinary era and can be ignored forever." "The target is derived from the signed 32-bit ceiling after reserving two safety bits, then stepping backward one bit for every earlier era." ]
	task.6250000000000001.title: "Acknowledge the consumptive mastery contract"
	quest.1240000000000001.title: "Coke for a Thousand Furnaces"
	quest.1240000000000001.quest_desc: ["Submit controlled carbon on the scale of a continental steel industry." "Submit and permanently consume 8,388,607 units. Progress is shared with the quest team." ]
	quest.2240000000000001.title: "The Steel Ocean"
	quest.2240000000000001.quest_desc: ["Submit the defining metal of heavy civilization." "Submit and permanently consume 8,388,607 units. Progress is shared with the quest team." ]
	quest.3240000000000001.title: "Granaries of Industry"
	quest.3240000000000001.quest_desc: ["Submit the biological production required to feed the steelworks." "Submit and permanently consume 8,388,607 units. Progress is shared with the quest team." ]
	quest.4240000000000001.title: "Every Node Remembered"
	quest.4240000000000001.quest_desc: ["Submit the accumulated evidence of industrial prospecting." "Submit and permanently consume 8,388,607 units. Progress is shared with the quest team." ]
	quest.6210000000000002.title: "Master of Era 2"
	quest.6210000000000002.quest_desc: ["The settlement has consumed 8,388,607 units from each of four defining resource streams: 33,554,428 submitted items in total." "The final reward includes a deliberately uncraftable creative-mode artifact. This is extraordinary power earned through an optional, extraordinary resource sink." ]
	task.6250000000000002.title: "Accept the Era 2 Mastery Emblem"

	chapter.7300000000000000.title: "Era 3 Mastery — Petrochemical Civilization"
	chapter.7300000000000000.subtitle: "Optional civilization-scale proof of controlled chemical abundance"
	quest.6310000000000001.title: "Era 3 Mastery Project"
	quest.6310000000000001.quest_desc: ["Mastery is an optional civilization-scale sink. Each of the four branches requires 16,777,215 submitted items." "Every item task consumes its submissions. Deposit only resources the team has deliberately committed; these quests never unlock an ordinary era and can be ignored forever." "The target is derived from the signed 32-bit ceiling after reserving two safety bits, then stepping backward one bit for every earlier era." ]
	task.6350000000000001.title: "Acknowledge the consumptive mastery contract"
	quest.1340000000000001.title: "Coke From the Deep Earth"
	quest.1340000000000001.quest_desc: ["Submit the solid carbon residue of civilization-scale refining." "Submit and permanently consume 16,777,215 units. Progress is shared with the quest team." ]
