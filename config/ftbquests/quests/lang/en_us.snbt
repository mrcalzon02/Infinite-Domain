	quest.5D0000000000000D.title: "Outer Cold Expedition: Mines"
	quest.5D0000000000000E.quest_desc: [
		"Find the iceberg mines in frozen ocean. This structure is deliberately not forced onto the central island."
		"Objective: enter Iceberg Mines. The terminal verifies the generated structure while you stand inside it."
