	quest.5D0000000000000C.title: "Band III: Biomass Tower"
	quest.5D0000000000000D.quest_desc: [
		"Leave the central Wasteland ring and find the Spore mines in a qualifying cold biome."
		"Objective: enter Mines. The terminal verifies the generated structure while you stand inside it."
