	]
	quest.5D00000000000016.title: "Southern Survey: Sulfuric Valley"
	quest.5D00000000000017.quest_desc: [
		"Enter the southern jungle and survey dense-canopy travel, renewable biomass, and disease-control requirements."
		"Objective: visit Jungle. The terminal detects the biome at your position automatically."
