	quest.5D00000000000008.title: "Band II: Military Camp"
	quest.5D00000000000009.quest_desc: [
		"Enter the hospital and separate medical salvage from infected biological material."
		"Objective: enter Hospital. The terminal verifies the generated structure while you stand inside it."
	]
	quest.5D00000000000009.title: "Band II: Hospital"
	quest.5D0000000000000A.quest_desc: [
		"Enter the prison only after the settlement can support a sustained containment expedition."
		"Objective: enter Prison. The terminal verifies the generated structure while you stand inside it."
	]
	quest.5D0000000000000A.title: "Band III: Prison"
	quest.5D0000000000000B.quest_desc: [
		"Reach the cathedral and map its full footprint before beginning salvage."
		"Objective: enter Cathedral. The terminal verifies the generated structure while you stand inside it."
