	quest.5A00000000000005.title: "A Chest With Memory"
	quest.5A00000000000006.quest_desc: [
		"Build a 1K item cell and learn type limits, bytes, formatting, and safe removal."
		"Objective: obtain 1 × Item Storage Cell 1k. The terminal detects these items without consuming them."
	]
	quest.5A00000000000006.title: "The First Thousand"
	quest.5A00000000000007.quest_desc: [
		"Move refinery fluids into explicit digital storage without treating a cell as an infinite tank."
		"Objective: obtain 1 × Fluid Storage Cell 4k. The terminal detects these items without consuming them."
	]
	quest.5A00000000000007.title: "Fluids Become Records"
	quest.5A00000000000008.quest_desc: [
		"Use a Cell Workbench to configure partitioning and upgrades deliberately."
		"Objective: obtain 1 × Cell Workbench. The terminal detects these items without consuming them."
	]
	quest.5A00000000000008.title: "Maintain the Cells"
	quest.5A00000000000009.quest_desc: [
		"Connect external power to an ME network and verify that storage remains reachable through a controlled shutdown."
		"Objective: obtain 1 × Energy Acceptor. The terminal detects these items without consuming them."
	]
	quest.5A00000000000009.title: "A Powered Network"
	quest.5A0000000000000A.quest_desc: [
		"Install a terminal for access and a drive for protected cell storage."
		"Objective: obtain 1 × Terminal. The terminal detects these items without consuming them."
	]
	quest.5A0000000000000A.title: "Terminal and Drive"
	quest.5A0000000000000B.quest_desc: [
		"Commission a controller only after documenting channel routes and critical devices."
		"Objective: obtain 1 × Controller. The terminal detects these items without consuming them."
	]
	quest.5A0000000000000B.title: "Network Governance"
	quest.5A0000000000000C.quest_desc: [
		"Encode and provide repeatable recipes whose inputs and byproducts have been audited."
		"Objective: obtain 2 × Pattern Provider. The terminal detects these items without consuming them."
	]
	quest.5A0000000000000C.title: "Patterns Are Promises"
	quest.5A0000000000000D.quest_desc: [
		"Bring controlled crafting into the network without hiding broken production chains."
		"Objective: obtain 1 × Crafting Terminal. The terminal detects these items without consuming them."
	]
	quest.5A0000000000000D.title: "Civilization Autocrafts"
	quest.5A0000000000000E.quest_desc: [
		"Build both halves of a quantum bridge and secure its chunk-loading and power assumptions."
		"Objective: obtain 2 × Quantum Link. The terminal detects these items without consuming them."
	]
	quest.5A0000000000000E.title: "Quantum Distance"
	quest.5A0000000000000F.quest_desc: [
		"Claim the Infinite Storage Cell awarded by the Infinite Domain capstone, then let the terminal verify that you are carrying it."
		"Objective: obtain 1 × Infinite Storage Cell. The terminal detects these items without consuming them."
	]
	quest.5A0000000000000F.title: "Infinite Domain Storage"
	quest.5B00000000000001.quest_desc: [
		"Enter the Spore hospital and recover medical knowledge without assuming the building is safe."
		"Objective: enter Hospital. The terminal verifies the generated structure while you stand inside it."
	]
	quest.5B00000000000001.title: "Search the Hospital"
	quest.5B00000000000002.quest_desc: [
		"Establish a clean station for cyberware inspection and component work."
		"Objective: obtain 1 × Cyberware Workbench. The terminal detects these items without consuming them."
	]
	quest.5B00000000000002.title: "A Workbench for Bodies"
	quest.5B00000000000003.quest_desc: [
		"Use diagnostics before surgery; implant slots and tolerances are part of the procedure."
		"Objective: obtain 1 × Scanner. The terminal detects these items without consuming them."
	]
	quest.5B00000000000003.title: "Know Before Cutting"
	quest.5B00000000000004.quest_desc: [
		"Stock the medicine that makes augmentation a maintained system rather than a one-way gamble."
		"Objective: obtain 8 × Neuropozyne. The terminal detects these items without consuming them."
	]
	quest.5B00000000000004.title: "Neuropozyne Reserve"
	quest.5B00000000000005.quest_desc: [
		"Build the modern surgery table and place it in a protected medical room."
		"Objective: obtain 1 × Surgery Table. The terminal detects these items without consuming them."
	]
	quest.5B00000000000005.title: "Sterile Surgery"
	quest.5B00000000000006.quest_desc: [
		"Produce standardized component boxes instead of depending on random salvage."
		"Objective: obtain 4 × Component Box. The terminal detects these items without consuming them."
	]
	quest.5B00000000000006.title: "Reproducible Components"
	quest.5B00000000000007.quest_desc: [
		"Manufacture a plated limb as a repairable industrial prosthesis."
		"Objective: obtain 1 × Basecyberware Leftarm Ironplated. The terminal detects these items without consuming them."
	]
	quest.5B00000000000007.title: "The First Prosthesis"
	quest.5B00000000000008.quest_desc: [
		"Installable monitoring is the first reward for surviving a world whose hazards are often invisible."
		"Objective: obtain 1 × Eyeupgrades Biomonitor. The terminal detects these items without consuming them."
	]
	quest.5B00000000000008.title: "Environmental Optics"
	quest.5B00000000000009.quest_desc: [
		"Build biological support suited to petrochemical and wasteland exposure."
		"Objective: obtain 1 × Organsupgrades Liverfilter. The terminal detects these items without consuming them."
	]
	quest.5B00000000000009.title: "Filtered Metabolism"
	quest.5B0000000000000A.quest_desc: [
		"Treat personal electrical storage as medical equipment with an operating envelope."
		"Objective: obtain 1 × Organsupgrades Battery. The terminal detects these items without consuming them."
	]
	quest.5B0000000000000A.title: "Powered Organs"
	quest.5B0000000000000B.quest_desc: [
		"The old Port clinic is incompatible with the cyberware system now governing this world. Retire it instead of building a second, misleading surgery chain."
		"Establish one Create Cybernetics Engineering Table and one Robosurgeon. Together they provide the supported fabrication and surgery route; the terminal detects both without consuming them."
	]
	quest.5B0000000000000B.title: "Robotic Assistance"
	quest.5B0000000000000C.quest_desc: [
		"Manufacture a neural processor only after automated industry can reproduce its electronics."
		"Objective: obtain 1 × Brainupgrades Neuralprocessor. The terminal detects these items without consuming them."
	]
	quest.5B0000000000000C.title: "Neural Processing"
	quest.5B0000000000000D.quest_desc: [
		"Create a specialist industrial implant; it is an option, not a universal requirement."
		"Objective: obtain 1 × Armupgrades Drillfist. The terminal detects these items without consuming them."
	]
	quest.5B0000000000000D.title: "Integrated Tooling"
	quest.5B0000000000000E.quest_desc: [
		"Reserve high-energy protection for teams that have actually mastered the atomic era."
		"Objective: obtain 1 × Module Radiation Protection. The terminal detects these items without consuming them."
	]
	quest.5B0000000000000E.title: "Radiation Survival"
	quest.5B0000000000000F.quest_desc: [
		"Reach the final computational implant without making it a compulsory definition of success."
		"Objective: obtain 1 × Netherite Qpu. The terminal detects these items without consuming them."
	]
	quest.5B0000000000000F.title: "Posthuman Stewardship"
	quest.5B00000000000010.quest_desc: [
		"The sole useful construction diagram was buried in the Cyberspace gallery. I have copied it here because archaeology should not be a prerequisite for reading assembly instructions."
		"{image:kubejs:textures/gui/quests/cyberspace_virtual_machine_multiblock.png width:384 height:216 align:1}"
		"Build three 3 × 3 layers. Layer 1 is nine Virtual Machine Casings. Layer 2 has casings in all four corners and the Virtual Machine Core in the center; leave the four edge-centre positions empty. Layer 3 is a ring of eight casings with the center empty."
		"That is twenty-one Virtual Machine Casings and one Virtual Machine Core in total. Once every block is positioned exactly as shown, use the Wrench on the structure to complete the Virtual Machine. If it does nothing, compare the empty spaces as carefully as the occupied ones before blaming reality."
		"Place a Terminal nearby. The Terminal is the computer used to connect to the completed Virtual Machine and enter Cyberspace. The default key for leaving Cyberspace is C. Remember it before entering; discovering that your exit key exists while already trapped would be admirably on-brand."
	]
	quest.5B00000000000010.title: "The Virtual Machine, Since Nobody Wrote a Manual"
	quest.5B00000000000011.quest_desc: [
		"Use the nearby Terminal to connect through the completed Virtual Machine and enter Cyberspace. The terminal must be close enough to the multiblock to discover it; moving the computer nearer is generally faster than insisting that wireless range respect your feelings."
		"Objective: enter Cyberspace. Press C—the default Leave Cyberspace binding—to return. If you changed the key, consult Controls before treating dimensional imprisonment as a software defect."
	]
	quest.5B00000000000011.title: "First Connection to Cyberspace"
	quest.5B0A949610E886A0.quest_desc: [
		"Goats provide milk and renewable horns, but require more infrastructure to exploit."
		"This exchange supplies one spawn egg and can be repeated."
	]
	quest.5B0A949610E886A0.title: "Goat Spawn Egg - 2 Cogs"
	quest.5C00000000000001.quest_desc: [
		"Travel beyond the dead center and enter a living plains biome. The biome task completes from the registered biome ID."
		"Objective: visit Plains. The terminal detects the biome at your position automatically."
	]
	quest.5C00000000000001.title: "Find Living Ground"
	quest.5C00000000000002.quest_desc: [
		"Set aside breeding stock before milling or eating the harvest."
		"Objective: obtain 64 × Wheat Seeds. The terminal detects these items without consuming them."
	]
	quest.5C00000000000002.title: "Seed Bank"
	quest.5C00000000000003.quest_desc: [
		"Farmer's Delight turns recovered soil and crops into renewable meals and maintained kitchens."
		"Build fertility through compost and organic cycling rather than consuming the last intact soil."
		"Objective: obtain 16 × Rich Soil. The terminal detects these items without consuming them."
	]
	quest.5C00000000000003.title: "Reclaimed Soil"
	quest.5C00000000000004.quest_desc: [
		"Enter a swamp and survey water, clay, mushrooms, vines, and medicinal feedstocks."
		"Objective: visit Swamp. The terminal detects the biome at your position automatically."
	]
	quest.5C00000000000004.title: "Wetland Pharmacy"
	quest.5C00000000000005.quest_desc: [
		"Commission a kitchen that can convert mixed crops into reliable meals."
		"Objective: obtain 1 × Cooking Pot. The terminal detects these items without consuming them."
	]
	quest.5C00000000000005.title: "A Real Kitchen"
	quest.5C00000000000006.quest_desc: [
		"Provision a work crew with cooked, renewable food."
		"Objective: obtain 32 × Vegetable Soup. The terminal detects these items without consuming them."
	]
	quest.5C00000000000006.title: "Meals for a Shift"
	quest.5C00000000000007.quest_desc: [
		"Enter a jungle and return with propagation material rather than stripping one site bare."
		"Objective: visit Jungle. The terminal detects the biome at your position automatically."
	]
	quest.5C00000000000007.title: "Tropical Seed Expedition"
	quest.5C00000000000008.quest_desc: [
		"Brewery uses grapes, barley, hops, yeast, and Create processing to produce beer, cider, and wine. Preserve specialist crop genetics for that later production chain."
		"Objective: obtain 16 × Grape Seed. The terminal detects these items without consuming them."
	]
	quest.5C00000000000008.title: "Orchard and Grain Diversity"
	quest.5C00000000000009.quest_desc: [
		"Maintain a clean culture and separate food preservation from recreational production."
		"Objective: obtain 16 × Brewers Yeast. The terminal detects these items without consuming them."
	]
	quest.5C00000000000009.title: "Controlled Fermentation"
	quest.5C0000000000000A.quest_desc: [
		"Survey the Wastelands forest as a restoration site and mark contamination before planting."
		"Objective: visit Forest. The terminal detects the biome at your position automatically."
	]
	quest.5C0000000000000A.title: "Forest Reclamation"
	quest.5C0000000000000B.quest_desc: [
		"Expand the two-dose field lesson into a sixteen-dose clinic reserve. Maintain emergency medicine as a reserve, not as permission for avoidable exposure."
		"Objective: obtain 16 × Rad Away. The terminal detects these items without consuming them."
	]
	quest.5C0000000000000B.title: "Clinic Stock"
	quest.5C0000000000000C.quest_desc: [
		"Provide beds, lighting, sanitation, food storage, and protected access for a settlement-scale habitation block."
		"Objective: obtain 16 × White Bed. The terminal detects these items without consuming them."
	]
	quest.5C0000000000000C.title: "Habitation Standard"
	quest.5D00000000000001.quest_desc: [
		"Carry respiratory protection, medicine, food, blocks, and a marked retreat route before entering Spore territory."
		"Objective: obtain 1 × Gas Mask. The terminal detects these items without consuming them."
	]
	quest.5D00000000000001.title: "Expedition Protection"
	quest.5D00000000000002.quest_desc: [
		"Enter the nearest Spore cell. This begins the central-island landmark survey."
