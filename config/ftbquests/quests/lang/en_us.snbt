	quest.7811000000000001.title: "A Renewable Metallurgical Feedstock"
	quest.7811000000000001.quest_desc: ["minecraft:wheat_seeds supplies renewable organic material for regenerative refining. This is an industrial crop input, not an arbitrary bonus ingredient." "Obtain 32 units after reaching the era's Farming milestone." ]
	quest.7811000000000002.title: "Extract the Active Fraction"
