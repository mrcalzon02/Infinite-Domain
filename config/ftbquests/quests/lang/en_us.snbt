	quest.5D00000000000017.title: "Southern Survey: Jungle Interior"
	quest.5D00000000000018.quest_desc: [
		"Reach a southern mangrove delta and chart navigable channels, stable construction ground, and wetland resources."
		"Objective: visit Mangrove Swamp. The terminal detects the biome at your position automatically."
	]
	quest.5D00000000000018.title: "Southern Survey: Mangrove Delta"
	quest.5D00000000000019.quest_desc: [
		"Enter the sulfuric valley with respiratory protection and a contamination-aware retreat plan."
