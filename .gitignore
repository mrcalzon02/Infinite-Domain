# Infinite Domain source repository scope
#
# Preserve project-owned pack data and custom code. Never redistribute third-party
# binaries or local player/runtime state through this repository.

# Third-party mod binaries are excluded. Only the six project-built artifacts use
# the infinite-domain-* prefix and are explicitly retained for pack parity.
/mods/*
!/mods/infinite-domain-*.jar

# Local launch/runtime state
/.cache/
/.codex/
/.mixin.out/
/.pg-native/
/.sable/
/.curseclient
/.qmenu_opened.marker
/backups/
/crash-reports/
/downloads/
/dynamic-data-pack-cache/
/dynamic-resource-pack-cache/
/ldlib2/
/local/
/logs/
/logs.zip
/moonlight-global-datapacks/
/nodes/
/saves/
/screenshots/
/shaderpacks/
/tmp/
/usercache.json
/usernamecache.json
/fabricloader.log
/hs_err_pid*.log
/command_history.txt
/options.txt
/ponders_watched.json
/config/jei/world/

# Local client/runtime configuration generated or rewritten by installed mods.
/config/fabric/indigo-renderer.properties
/config/ftbchunks-client.snbt
/config/graveyard-common-*.toml.bak
/config/submarine_hull.json

# A nested scratch checkout of the same GitHub repository is not project content.
/Infinite-Domain/

# Generated build products and dependency caches. Custom mod sources remain tracked.
**/.gradle/
**/build/
**/bin/
**/out/
**/__pycache__/
**/*.pyc

# Third-party/base resource-pack ZIPs are excluded. Only the combined project pack
# (LAST_DAYS_INFINITE_DOMAIN_1_21_1) is retained.
/resourcepacks/*
!/resourcepacks/LAST_DAYS_INFINITE_DOMAIN_1_21_1.zip
!/resourcepacks/LAST_DAYS_INFINITE_DOMAIN_1_21_1/

# Generated/reference review payloads are reproducible and may contain upstream art.
/docs/texture-audit/
/structure_library/sources/
/structure_library/extracted/creativelands_cc0/
/structure_library/reviews/creativelands_cc0/

# Local authoring/recovery payloads are intentionally kept off the distributable repo.
/ROOT_tools/
